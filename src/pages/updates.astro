---
import Base from '../layouts/Base.astro';
import Lists from '../components/Lists.astro';
import { ELEMENTS, loadAll } from '../lib/content';
const { updates } = await loadAll();
---
<Base title="Updates · Alvin" description="Alvin 的近況。">
  <div class="page-head">
    <h1>Updates<span class="stop">.</span></h1>
    <p class="el-links">{ELEMENTS.map((e) => <a href={`/${e.slug}#updates`}>{e.zh} {e.domain}</a>)}</p>
  </div>
  <div class="writing-list"><Lists kind="updates" items={updates} /></div>
</Base>
