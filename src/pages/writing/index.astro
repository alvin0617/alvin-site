---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing — Alvin" description="Research notes on crypto markets and AI infrastructure.">
  <div class="page-head">
    <h1>Writing<span class="stop">.</span></h1>
    <p>Research notes on crypto markets and AI infrastructure. The long-form pieces are on the Cryptowesearch Substack.</p>
  </div>
  <div class="writing-list">
    <ul class="list">
      {posts.map((post) => (
        <li>
          <a class="item" href={`/writing/${post.id}`}>
            <span class="t">{post.data.title}</span>
            <span class="d">{fmt(post.data.date)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
